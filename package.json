{
  "name": "@heretek-ai/juicyads-mcp",
  "version": "0.1.0",
  "description": "MCP server for the JuicyAds API v1",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "juicyads-mcp": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Heretek-AI/juicyads-mcp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "prepack": "node -e \"const fs=require('fs');const f='dist/index.js';if(fs.existsSync(f))fs.chmodSync(f,0o755)\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "dev": "node --watch src/index.ts",
    "test": "node --test test/*.test.ts",
    "test:unit": "node --test test/dates.test.ts test/client.test.ts test/errors.test.ts",
    "test:live": "node --test test/live.integration.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
