# JuicyAds API token — a credential passed as a URL path segment to api.juicyads.com.
# Never commit the real value. The server reads JUICYADS_API_TOKEN from the process
# environment at startup (it does not load .env files itself — export it, or pass it
# through `claude mcp add --env`).
JUICYADS_API_TOKEN=replace-me
